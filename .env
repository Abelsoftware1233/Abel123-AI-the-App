# URL waar Ollama draait (standaard lokaal, meestal niet aanpassen)
OLLAMA_URL=http://localhost:11434

# Chatmodel - kies llama3 of mistral (of een ander tekstmodel dat je hebt gepulld)
CHAT_MODEL=llama3

# Visiemodel voor gezichts-/afbeeldingsanalyse - MOET een vision-model zijn
VISION_MODEL=llama3.2-vision